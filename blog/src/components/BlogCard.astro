---
import TagBadge from './TagBadge.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  readingTime?: string;
}

const { title, description, pubDate, slug, tags, readingTime } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<article class="interactive-card group block p-6 sm:p-7 rounded-2xl bg-[#202022] hover:bg-neutral-900 border border-neutral-800 hover:border-[#0099ff]/50 transition-all shadow-md space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-neutral-400">
    <time datetime={pubDate.toISOString()} class="flex items-center gap-1.5 text-neutral-400">
      <svg class="w-3.5 h-3.5 text-[#0099ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      {formattedDate}
    </time>
    {readingTime && (
      <span class="text-neutral-500 flex items-center gap-1">
        <span>&bull;</span>
        <span>{readingTime}</span>
      </span>
    )}
  </div>

  <div class="space-y-2">
    <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#0099ff] transition-colors leading-snug">
      <a href={`${base}/posts/${slug}`} class="focus:outline-none">
        {title}
      </a>
    </h2>
    <p class="text-neutral-300 text-sm sm:text-base leading-relaxed">
      {description}
    </p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
    <div class="flex flex-wrap items-center gap-1.5">
      {tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>

    <a 
      href={`${base}/posts/${slug}`}
      class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#0099ff] group-hover:text-[#ff9900] group-hover:translate-x-0.5 transition-all"
    >
      <span>Read post</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </a>
  </div>
</article>
