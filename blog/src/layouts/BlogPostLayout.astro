---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  heroImage?: string;
  readingTime?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'Giovanni Alvarez',
  tags = [],
  heroImage,
  readingTime,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articleUrl = Astro.url.href;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`;

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdateDate = updatedDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="space-y-8">
    <!-- Navigation back -->
    <div class="flex items-center justify-between">
      <a
        href={`${base}/`}
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-mono text-neutral-400 hover:text-[#0099ff] transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>All Posts</span>
      </a>

      <!-- Share Options: LinkedIn & Copy to clipboard -->
      <div class="flex items-center gap-2">
        <a
          href={linkedInShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-linkedin-share
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-[#0099ff] text-xs font-mono text-neutral-300 hover:text-white transition cursor-pointer"
          title="Share to LinkedIn"
          aria-label="Share to LinkedIn"
        >
          <svg class="w-3.5 h-3.5 text-[#0099ff] fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.77v8.37H6.46v-8.37M7.85 6.4a1.61 1.61 0 1 0 1.61 1.61A1.61 1.61 0 0 0 7.85 6.4Z"/>
          </svg>
          <span class="sm:hidden">LinkedIn</span>
          <span class="hidden sm:inline">Share to LinkedIn</span>
        </a>

        <button
          type="button"
          class="share-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-[#ff9900] text-xs font-mono text-neutral-300 hover:text-white transition cursor-pointer"
          title="Copy link to clipboard"
          aria-label="Copy link to clipboard"
        >
          <svg class="w-3.5 h-3.5 text-[#ff9900]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
          </svg>
          <span class="copy-label">
            <span class="sm:hidden">Copy link</span>
            <span class="hidden sm:inline">Copy to clipboard</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 pb-6 border-b border-neutral-800/90">
      <div class="flex items-center gap-2.5">
        <span class="h-2 w-7 rounded-full bg-[#ff9900]"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-[#ff9900]">Engineering Article</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-neutral-300 leading-relaxed font-normal">
        {description}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 text-xs font-mono text-neutral-400">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <img
              src="/images/avatar.jpg"
              alt={author}
              class="w-6 h-6 rounded-full object-cover border border-[#0099ff]"
              onerror="this.style.display='none'"
            />
            <span class="text-neutral-200">{author}</span>
          </div>
          <span>&middot;</span>
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {formattedUpdateDate && (
            <span class="text-neutral-500">(Updated: {formattedUpdateDate})</span>
          )}
        </div>

        {readingTime && (
          <span class="text-neutral-400">{readingTime}</span>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 pt-2">
          {tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
    </header>

    <!-- Optional Hero Image -->
    {heroImage && (
      <div class="rounded-2xl overflow-hidden border border-neutral-800">
        <img src={heroImage} alt={title} class="w-full h-auto object-cover max-h-[420px]" />
      </div>
    )}

    <!-- Markdown Content Container -->
    <div class="prose prose-invert prose-neutral max-w-none prose-pre:border prose-pre:border-neutral-800 prose-pre:bg-[#121212] prose-headings:tracking-tight prose-a:text-[#0099ff] hover:prose-a:text-[#ff9900] prose-code:text-[#ff9900]">
      <slot />
    </div>

    <!-- Article Footer / Share & Bio Card -->
    <div class="pt-8 border-t border-neutral-800/90 space-y-6">
      <!-- Share this article section -->
      <div class="p-4 sm:p-5 rounded-2xl bg-[#202022] border border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#ff9900]"></span>
            <span class="text-xs font-mono uppercase tracking-widest text-[#ff9900]">Share Article</span>
          </div>
          <p class="text-sm font-semibold text-white">Share this article with your network</p>
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto">
          <a
            href={linkedInShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-linkedin-share
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-[#0099ff] text-xs font-mono text-neutral-200 hover:text-white transition cursor-pointer"
            title="Share to LinkedIn"
            aria-label="Share to LinkedIn"
          >
            <svg class="w-4 h-4 text-[#0099ff] fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.77v8.37H6.46v-8.37M7.85 6.4a1.61 1.61 0 1 0 1.61 1.61A1.61 1.61 0 0 0 7.85 6.4Z"/>
            </svg>
            <span>Share to LinkedIn</span>
          </a>

          <button
            type="button"
            class="share-copy-btn flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-[#ff9900] text-xs font-mono text-neutral-200 hover:text-white transition cursor-pointer"
            title="Copy link to clipboard"
            aria-label="Copy link to clipboard"
          >
            <svg class="w-4 h-4 text-[#ff9900]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span class="copy-label">Copy to clipboard</span>
          </button>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-[#202022] border border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <img
          src="/images/avatar.jpg"
          alt="Giovanni Alvarez"
          class="w-14 h-14 rounded-full object-cover border-2 border-[#0099ff] ring-2 ring-neutral-900 shrink-0"
          onerror="this.style.display='none'"
        />
        <div class="space-y-1 text-left">
          <h2 class="text-base font-bold text-white">Giovanni Alvarez</h2>
          <p class="text-xs sm:text-sm text-neutral-400">
            15+ years building enterprise architecture, high-concurrency systems, and practical technology for businesses.
          </p>
          <div class="pt-1">
            <a href="/" class="text-xs font-mono text-[#0099ff] hover:text-[#ff9900] inline-flex items-center gap-1 transition">
              <span>View full resume &amp; portfolio</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between text-xs font-mono">
        <a
          href={`${base}/`}
          class="inline-flex items-center gap-1.5 text-neutral-400 hover:text-white transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          <span>Back to articles</span>
        </a>

        <a
          href="#"
          class="inline-flex items-center gap-1 text-neutral-400 hover:text-[#0099ff] transition"
        >
          <span>Back to top</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
          </svg>
        </a>
      </div>
    </div>
  </article>

  <div
    id="share-toast"
    class="pointer-events-none fixed bottom-5 left-1/2 z-50 -translate-x-1/2 rounded-lg border border-[#0099ff]/50 bg-neutral-900 px-4 py-2 text-sm font-mono text-white opacity-0 transition-opacity duration-200"
    role="status"
    aria-live="polite"
  ></div>

  <!-- Sharing Script -->
  <script>
    const copyButtonSelector = '.share-copy-btn';
    const linkedInShareSelector = '[data-linkedin-share]';

    function showShareToast(message) {
      const toast = document.getElementById('share-toast');
      if (!toast) return;

      toast.textContent = message;
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
      window.setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 2500);
    }

    async function copyArticleUrl() {
      const url = window.location.href;

      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(url);
          window.CodeMonkeyAnalytics?.track('article_share', { share_method: 'copy_link' });
          showShareToast('Article link copied to clipboard.');
          return;
        } catch (error) {
          console.warn('Clipboard API copy failed; trying fallback.', error);
        }
      }

      let copied = false;

      try {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        copied = document.execCommand('copy');
        textarea.remove();
      } catch (error) {
        console.warn('Legacy clipboard copy failed; opening manual copy prompt.', error);
      }

      if (copied) {
        window.CodeMonkeyAnalytics?.track('article_share', { share_method: 'copy_link' });
        showShareToast('Article link copied to clipboard.');
      } else {
        window.prompt('Copy article link:', url);
      }
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const linkedInLink = target.closest(linkedInShareSelector);
      if (linkedInLink instanceof HTMLAnchorElement) {
        window.CodeMonkeyAnalytics?.track('article_share', { share_method: 'linkedin' });
        event.preventDefault();
        const popup = window.open(
          linkedInLink.href,
          'linkedin-share',
          'popup,width=600,height=600,left=100,top=100',
        );

        if (popup) {
          popup.opener = null;
          popup.focus();
        } else {
          window.open(linkedInLink.href, '_blank', 'noopener,noreferrer');
        }
        return;
      }

      if (target.closest(copyButtonSelector)) {
        void copyArticleUrl();
      }
    });

    window.CodeMonkeyAnalytics?.trackArticleRead();
  </script>
</BaseLayout>
